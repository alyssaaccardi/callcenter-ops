# Overage Alerter runtime state. The outreach log holds customer email
# addresses, and all three are per-environment — committing them would also
# overwrite production's copies on deploy.
overage-alerter-calibration.json
overage-outreach-config.json
overage-outreach-log.json

# Runtime state, not source. tv-sessions.json holds live TV display session
# tokens and status-store.json holds current UP/DOWN state — both are
# per-environment and this repo is public. The server recreates either file on
# demand if it is missing.
tv-sessions.json
status-store.json

# AI Receptionist Testing Platform database (SQLite + WAL sidecars)
qa-platform.db
qa-platform.db-wal
qa-platform.db-shm

# AI Bot QC review queue and audit history
ai-bot-qc.db
ai-bot-qc.db-wal
ai-bot-qc.db-shm
