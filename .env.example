# Copy this file to .env and fill in your values
# The server reads from .env — never commit .env to git

PORT=3001

# Secret key the dashboard uses to authenticate with this backend
# Set the same value in the dashboard Settings > API Keys > Backend Connection
API_SECRET_KEY=change-me-to-something-secret

# Read-only API key for the dev team / external integrations.
# Pass as `X-API-Key: <key>` header on any GET /api/* request.
# Generate with: openssl rand -hex 32
DEV_API_KEY=

# EZTexting credentials (Basic auth)
EZTEXTING_USERNAME=your@email.com
EZTEXTING_PASSWORD=yourpassword

# Bandwidth credentials
BANDWIDTH_ACCOUNT_ID=12345678
BANDWIDTH_API_TOKEN=your-token
BANDWIDTH_API_SECRET=your-secret
BANDWIDTH_SAVVY_SITE_TAG=Stafford
BANDWIDTH_MITEL_SITE_TAG=Mitel

# Monday.com credentials
MONDAY_API_KEY=your-monday-api-key
MONDAY_BOARD_ID=your-board-id
MONDAY_STATUS_COLUMN_ID=status_column_id
MONDAY_HERE_LABEL=Here
MONDAY_STANDBY_LABEL=Standby

# Wix credentials (used by callcenter-ops.html legacy dashboard)
WIX_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WIX_API_KEY=your-wix-api-key
WIX_COLLECTION_NAME=SystemStatus

# JSONBin credentials are entered in the CCOB Dashboard UI (Settings > API Keys)
# and stored in browser localStorage — they are NOT needed here

# Mitel CloudLink REST API (optional — for live call data from the cloud)
MITEL_CL_USERNAME=your-mitel-email@company.com
MITEL_CL_PASSWORD=your-mitel-password
MITEL_CL_ACCOUNT_ID=your-account-id
MITEL_CL_APP_ID=your-app-id
# Comma-separated list of endpoint IDs to query for active calls
MITEL_CL_ENDPOINTS=endpoint-id-1,endpoint-id-2

# Belize Grid Watch — staff-outage dashboard
# GRID_BOARD_ID: monday.com board with agent home addresses (default = staffing board)
# GRID_GROUP_MATCH: substring match on group title — keeps historic snapshots out
# Falls back to MONDAY_API_KEY above if MONDAY_API_TOKEN is unset
GRID_BOARD_ID=18415794851
GRID_GROUP_MATCH=Active Employee Addresses
# Optional: set to 1 to supplement BEL's outage table with news scraping.
# Uses the same GEMINI_API_KEY the rest of the app already has. Model
# defaults to gemini-3.1-pro-preview with Google Search grounding —
# override with GRID_NEWS_MODEL for cheaper alternatives.
GRID_NEWS_SUPPLEMENT=0
# GRID_NEWS_MODEL=gemini-3.1-pro-preview
